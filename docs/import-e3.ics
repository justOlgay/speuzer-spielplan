BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//FFV Sportfreunde 04//Import//DE
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:Import Speuzer E3 – Spieltage für die App
X-WR-CALDESC:Zum Hochladen in einen appack-Kalender über „ICS importie
 ren“. Terminstart ist der Treffpunkt (Anstoß minus 60 Minuten). Nach 
 dem Import je Termin noch: Untertitel einsetzen\, Teilnahme-Rückmeldung
  anschalten\, Gruppe einladen. Diese Datei nur EINMAL importieren\, sons
 t stehen die Termine doppelt.
X-WR-TIMEZONE:Europe/Berlin
BEGIN:VTIMEZONE
TZID:Europe/Berlin
X-LIC-LOCATION:Europe/Berlin
BEGIN:DAYLIGHT
TZOFFSETFROM:+0100
TZOFFSETTO:+0200
TZNAME:CEST
DTSTART:19700329T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
TZNAME:CET
DTSTART:19701025T030000
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU
END:STANDARD
END:VTIMEZONE
END:VCALENDAR
